# Postgres (container haven-db)
POSTGRES_USER=haven
POSTGRES_PASSWORD=change-me
POSTGRES_DB=haven

# Backend (container haven-api)
NODE_ENV=production
PORT=3000
DATABASE_URL=postgres://haven:change-me@haven-db:5432/haven
APP_TIMEZONE=America/Sao_Paulo
RECONCILE_CRON=0 */4 * * *
SNAPSHOT_CRON=0 6 * * *

# Auth: an identity-aware proxy (Cloudflare Access, oauth2-proxy, Pomerium, ...) verifies the
# user and forwards a signed JWT in AUTH_IDENTITY_HEADER. "dev" injects a fixed identity instead
# and is refused whenever NODE_ENV=production.
AUTH_MODE=proxy
AUTH_JWKS_URL=https://your-domain.example/.well-known/jwks.json
AUTH_ISSUER=https://your-domain.example
AUTH_AUDIENCE=replace-with-your-access-application-aud
AUTH_IDENTITY_HEADER=cf-access-jwt-assertion

# Data provider: "mock" runs the whole app with a deterministic synthetic dataset and no
# third-party account. Switch to "pluggy" to sync real Open Finance Brasil connections
# (https://dashboard.pluggy.ai).
DATA_PROVIDER=mock
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=

# openssl rand -hex 32
WEBHOOK_SECRET=replace-me-with-32-random-hex-chars
WEBHOOK_PUBLIC_URL=https://your-domain.example/haven/api/webhooks?token=replace-me
